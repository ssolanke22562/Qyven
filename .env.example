# Groq API Key for Llama 3.3 70B & tool calling
GROQ_API_KEY=your_groq_api_key_here

# Groq Model override (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# News API Key for live market and competitor news retrieval (NewsAPI.org or GNews)
NEWS_API_KEY=your_news_api_key_here
