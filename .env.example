# Groq API Key for Llama 3.3 70B & tool calling
GROQ_API_KEY=your_groq_api_key_here

# Groq Model override (optional, defaults to openai/gpt-oss-120b or llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key for Gemini 2.5 Flash / 3.6 Flash inference
GEMINI_API_KEY=your_gemini_api_key_here

# News API Key for live market and competitor news retrieval (NewsData.io, GNews, or NewsAPI.org)
NEWS_API_KEY=your_news_api_key_here

# GitHub Repository URL (fill in your real GitHub repository URL before deployment; if omitted/empty, GitHub links will be hidden)
NEXT_PUBLIC_GITHUB_URL=https://github.com/ssolanke22562/Qyven

# Architecture Documentation / Whitepaper URL (fill in your real doc URL before deployment; if omitted/empty, whitepaper button opens interactive modal)
NEXT_PUBLIC_ARCHITECTURE_DOC_URL=
